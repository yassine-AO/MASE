# Keep directory placeholders
!.gitkeep

# Python virtual environments and caches
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
*.egg-info/
.eggs/
dist/
build/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Frontend build outputs
frontend/dist/
frontend/build/
.next/
out/
*.tsbuildinfo

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test and linter caches
.pytest_cache/
.coverage
htmlcov/
coverage/
.tox/
.mypy_cache/
.ruff_cache/

# Local databases
*.db
*.sqlite
*.sqlite3
postgres_data/

# Temporary files and logs
tmp/
temp/
*.tmp
*.bak
*.log
logs/

# Uploaded PDFs and user documents
uploads/
tmp_uploads/
user_documents/
*.pdf
!docs/**/*.pdf

# ML checkpoints, embeddings, and large generated artifacts
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.pkl
*.joblib
*.h5
*.faiss
ml/models/*
!ml/models/.gitkeep
ml/datasets/*.parquet
ml/datasets/*.csv
ml/datasets/*.jsonl
wandb/
mlruns/
